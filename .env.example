# Скопируй в .env и подставь свои значения.
# PostgreSQL: локально, Docker (см. docker-compose.yml) или облако (Render и т.д.).
# Node: версия в .nvmrc (например 20) — согласуй с хостом (Render подхватит).

# --- Render (прод) — кратко ---
# 1) New → PostgreSQL (или Blueprint из render.yaml: БД+API вместе).
# 2) Web Service: Build =  npm install && npm run build   (миграции: prisma migrate deploy)
#    Start  =  npm start
# 3) Environment: минимум DATABASE_URL, GROQ_API_KEY, ATON_PUBLIC_URL (твой сайт в интернете).
# 4) В браузере проверь  https://ТВОЙ-API.onrender.com/api/health  →  "ok": true
# 5) Сайт (FTP): в index.html / forgot / reset / admin-users meta aton-api-base = URL API без слэша в конце.
# Секреты (Groq, OpenAI) только в панели Render, не в git.

# --- FTP (только на твоём ПК для npm run deploy:site) — не нужны на Render ---
# FTP_HOST=
# FTP_USER=
# FTP_PASS=
# FTP_PORT=21
# FTP_REMOTE_DIR=public_html
# FTP_DEBUG=0

# Вариант A — свой пользователь postgres
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aton?schema=public"

# Вариант B — после `docker compose up -d` из этого репозитория:
DATABASE_URL="postgresql://aton:aton_dev_local@localhost:5432/aton?schema=public"

# Публичный URL сайта (для ссылок в письмах и аватара Голоса Атона: {URL}/golos-aton-avatar.png)
# ATON_PUBLIC_URL=https://aten.vadzim.by

# SMTP (для отправки писем — восстановление пароля, уведомления)
# ATON_SMTP_HOST=smtp.gmail.com
# ATON_SMTP_PORT=587
# ATON_SMTP_USER=your@gmail.com
# ATON_SMTP_PASS=your-app-password
# ATON_FROM_EMAIL=noreply@aton.app

# Groq (ответы «Голоса Атона», расшифровка голоса Whisper): https://console.groq.com — только в .env
# GROQ_API_KEY=gsk_...
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# Резерв, если основная модель вернула 400/404 (см. lib/golos-groq.js)
# GROQ_TEXT_MODEL_FALLBACK=llama-3.1-8b-instant
# GROQ_STT_MODEL=whisper-large-v3-turbo
# Лимит токенов ответа (меньше — быстрее и дешевле, обычно 600–1200)
# GROQ_MAX_TOKENS=900
# Сколько повторов при HTTP 429 (лимит Groq), по умолчанию 3
# GROQ_429_RETRIES=3

# Память диалога с Голосом Атона (как в ChatGPT): сколько последних сообщений беседы подмешивать в запрос (2–100).
# GOLOS_HISTORY_MAX_MESSAGES=40
# Суммарный лимит символов истории, старые ходы отбрасываются.
# GOLOS_MAX_CONTEXT_CHARS=40000

# Ограничение числа обращений к Голосу Атона за 1 ч (0 = отключить; по умолчанию 0).
# GOLOS_MAX_PER_WINDOW=0

# Озвучка ответа Голоса Атона (голос в ответ на голос). GROQ_API_KEY — для STT+чата; для лучшей TTS (женский nova) — OPENAI. Без OpenAI: Google TTS, длинный текст — несколько кусков.
# OPENAI_API_KEY=sk-...
