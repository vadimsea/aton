# Скопируй в .env и подставь свои значения.
# PostgreSQL: локально, Docker (см. docker-compose.yml) или облако (Render и т.д.).

# Вариант A — свой пользователь postgres
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aton?schema=public"

# Вариант B — после `docker compose up -d` из этого репозитория:
DATABASE_URL="postgresql://aton:aton_dev_local@localhost:5432/aton?schema=public"
