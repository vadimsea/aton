# Скопируйте в .env в корне или экспортируйте в shell для локального запуска ботов.

GROQ_API_KEY=
# Опционально
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Фронт-бот
QA_FRONTEND_URL=https://aten.vadzim.by
QA_BOT_TOKEN=

# Бэк-бот
QA_BASE=https://aton-api.onrender.com

# FTP: отдельная папка с отчётами (тот же хост, что и сайт)
FTP_HOST=ftp.example.com
FTP_USER=
FTP_PASS=
FTP_QA_DIR=/public_html/qa-bots
# FTP_DEBUG=1
