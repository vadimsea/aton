# Скопируйте в .env в корне или экспортируйте в shell для локального запуска ботов.

GROQ_API_KEY=
# Опционально
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Фронт-бот
QA_FRONTEND_URL=https://aten.vadzim.by
QA_BOT_TOKEN=
# Опц.: автополучение токена: node scripts/fetch-qa-bot-token.mjs
# QA_BOT_EMAIL=
# QA_BOT_PASSWORD=
# Опц.: заливка секретов без браузера: echo PAT | gh auth login --with-token
# GITHUB_PAT=

# Бэк-бот
QA_BASE=https://aton-api.onrender.com

# FTP: отдельная папка с отчётами (тот же доступ, что к сайту; хост смотрите в панели)
FTP_HOST=vh141.hoster.by
FTP_USER=aten@aten.vadzim.by
FTP_PASS=
FTP_PORT=21
FTP_QA_DIR=qa-bots
# FTP_DEBUG=1
