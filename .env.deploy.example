# Скопируйте в .env.deploy (файл в .gitignore) и заполните.
# URL бэкенда в HTML: meta aton-api-base, не обязателен здесь. Ниже — пример.
# URL бэкенда на Render (без слэша в конце):
ATON_API_BASE=https://your-service.onrender.com

# Заливка статики: npm run deploy:site (SFTP). Пароль в репозиторий не кладём:
# задайте его в окружении или в .env.deploy (файл в .gitignore).
#   PowerShell:  $env:ATEN_SFTP_USER='...'; $env:ATEN_SFTP_PASSWORD='...'; npm run deploy:site
#   Проверка без записи:  npm run deploy:site -- --dry-run
ATEN_SFTP_USER=login
ATEN_SFTP_PASSWORD=password
# Необязательно (значения по умолчанию для vh161.hoster.by):
# ATEN_SFTP_HOST=vh161.hoster.by
# ATEN_SFTP_PORT=22
# ATEN_SFTP_REMOTE_DIR=www/aten.vadzim.by
# ATEN_SFTP_HOST_FINGERPRINT=SHA256:...   (отпечаток ключа сервера; "off" — не проверять)

# Для QA-ботов (отдельные скрипты, по-прежнему FTP):
# FTP_HOST=ftp.example.com
# FTP_USER=login
# FTP_PASS=password
# FTP_PORT=21

# Отдельная папка для отчётов QA-ботов — тот же путь, что в .env (GitHub Secret FTP_QA_DIR), напр.:
# FTP_QA_DIR=qa-bots
