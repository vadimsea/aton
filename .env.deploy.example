# Скопируйте в .env.deploy (файл в .gitignore) и заполните.
# URL бэкенда на Render (без слэша в конце):
ATON_API_BASE=https://your-service.onrender.com

FTP_HOST=ftp.example.com
FTP_USER=login
FTP_PASS=password
# Каталог на сервере, куда класть index.html, main.js, style.css (часто /public_html или /www/домен):
FTP_REMOTE_DIR=/public_html

# Отдельная папка для отчётов QA-ботов (Groq) — копия в GitHub Secret FTP_QA_DIR, пусть совпадает, например:
# FTP_QA_DIR=/public_html/qa-bots
