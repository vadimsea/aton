# Скопируйте в .env.deploy (файл в .gitignore) и заполните.
# Статика на хост: npm run deploy:site (FTP; можно дублировать ключи в .env)
# URL бэкенда в HTML: meta aton-api-base, не обязателен здесь. Ниже — пример.
# URL бэкенда на Render (без слэша в конце):
ATON_API_BASE=https://your-service.onrender.com

FTP_HOST=ftp.example.com
FTP_USER=login
FTP_PASS=password
# Каталог на сервере (лучше без ведущего /, от chroot FTP — см. панель/файл-менеджер), например:
# public_html
# domains/mysite.by/public_html
FTP_REMOTE_DIR=public_html
FTP_PORT=21

# Отдельная папка для отчётов QA-ботов — тот же путь, что в .env (GitHub Secret FTP_QA_DIR), напр.:
# FTP_QA_DIR=qa-bots
